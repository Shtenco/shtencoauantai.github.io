    event RobotRefill(string source, uint256 usdtAdded, uint256 tokenSpent, uint256 liquidityRemoved);
    event FeeBpsUpdated(uint256 feeBps);

    modifier onlyOwner() {
        if (!(msg.sender == owner)) revert SynergyError(1052);
        _;
    }

    mod